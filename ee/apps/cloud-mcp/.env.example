# Cloud MCP listens separately from den-api and den-gateway.
PORT=8791

# Required primary and read-only replica. Reads use the replica per request;
# writes, transactions, locking reads, and post-write reads use the primary.
DATABASE_URL=mysql://user:password@primary.example.com:3306/openwork_den
DATABASE_REPLICA_URL=mysql://user:password@replica.example.com:3306/openwork_den
DB_MODE=mysql
DEN_DB_ENCRYPTION_KEY=replace-with-at-least-32-characters

BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=https://app.openworklabs.com

# CRITICAL OAUTH IDENTITY: cloud-mcp shares den-api's existing public ingress.
# Keep both values byte-identical to den-api. Changing either can reject all
# existing MCP tokens or advertise callbacks/resources on the wrong service.
DEN_MCP_RESOURCE_URL=https://api.openworklabs.com/mcp
DEN_API_PUBLIC_URL=https://api.openworklabs.com

# Set automatically by this package's dev/test/start scripts. This exact
# service identity is the opt-in that enables den-core replica routing. This
# resource-server host also disables OAuth authorization-server catalog seeding.
DEN_DB_ROUTING_SERVICE=cloud-mcp
DEN_MCP_OAUTH_RESOURCE_SEEDING=disabled
OTEL_SERVICE_NAME=cloud-mcp

# Optional browser origins allowed to call this MCP surface.
CORS_ORIGINS=https://app.openworklabs.com
