{
  "name": "@openwork-ee/den-core",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "bun": "./src/*.ts",
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:utils && pnpm run build:den-db && pnpm run build:automations && pnpm run build:email && pnpm run build:enterprise-mcp-client && pnpm run build:codemode && pnpm run build:headless-threads && tsc -p tsconfig.json",
    "build:types": "pnpm --filter @openwork/types build",
    "build:utils": "pnpm --filter @openwork-ee/utils build",
    "build:den-db": "pnpm --filter @openwork-ee/den-db build",
    "build:automations": "pnpm --filter @openwork/automations build",
    "build:email": "pnpm --filter @openwork/email build",
    "build:enterprise-mcp-client": "pnpm --filter @openwork/enterprise-mcp-client build",
    "build:codemode": "pnpm --filter @openwork/codemode build",
    "build:headless-threads": "pnpm --filter @openwork/headless-threads build",
    "test": "bun test test/*.test.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.0-beta.10",
    "@better-auth/oauth-provider": "1.7.0-beta.10",
    "@better-auth/scim": "1.7.0-beta.10",
    "@better-auth/sso": "1.7.0-beta.10",
    "@daytonaio/sdk": "^0.201.0",
    "@hono/mcp": "^0.2.5",
    "@hono/otel": "1.1.2",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.220.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.220.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "@opentelemetry/semantic-conventions": "1.42.0",
    "@openwork-ee/den-db": "workspace:*",
    "@openwork-ee/utils": "workspace:*",
    "@openwork/automations": "workspace:*",
    "@openwork/codemode": "workspace:*",
    "@openwork/email": "workspace:*",
    "@openwork/enterprise-mcp-client": "workspace:*",
    "@openwork/headless-threads": "workspace:*",
    "@openwork/types": "workspace:*",
    "@sentry/hono": "10.64.0",
    "better-auth": "1.7.0-beta.10",
    "dotenv": "^16.4.5",
    "effect": "4.0.0-beta.83",
    "esbuild": "catalog:",
    "hono": "4.12.34",
    "hono-openapi": "^1.3.0",
    "ioredis": "^6.0.0",
    "nanoid": "3.3.18",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "0.35.3",
    "stripe": "^22.1.1",
    "undici": "7.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "19.2.14",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
