+const REFRESH_TOKEN_ROTATION_GRACE_MS = 30_000;
+// Only token hashes are stored, so an overlap replay can issue another
+// successor instead of returning prior plaintext. Stale replays still
+// invalidate the family; successors remain normal rotating grants.
+function isRefreshTokenRotationWithinGrace(refreshToken) {
